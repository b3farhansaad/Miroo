<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Miroo ✿ | Portrait of a Dreamer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,400;1,600&family=Great+Vibes&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">

<style>
/* إغلاق أي مساحات بيضاء أو بواقي في الموقع */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body, html {
    width: 100vw;
    height: 100vh;
    overflow: hidden !important; /* يمنع أي سكرول أو مساحات بيضاء تحت */
    position: relative;
    background-color: #0d0f12;
}

/* الخلفية الأصلية والأنيميشن */
body::before {
    content: ''; 
    position: fixed; 
    inset: -5%; /* مساحة إضافية لتجنب ظهور الأطراف أثناء الأنيميشن */
    background: url('anime_bg.jpeg') center/cover no-repeat;
    z-index: -2;
    animation: bgpan 18s ease-in-out infinite alternate;
}
body::after {
    content: ''; 
    position: fixed; 
    inset: 0;
    background: rgba(10,10,20,.35);
    z-index: -1;
}

@keyframes bgpan {
    from { transform: scale(1.05); }
    to { transform: scale(1.12) translateY(-1%); }
}

/* الورود الزرقاء المساقطة */
.blue-rose {
    position: fixed;
    top: -120px;
    pointer-events: none;
    z-index: 4;
    opacity: .85;
    animation: fall linear infinite;
}

@keyframes fall {
    0% { transform: translateY(-120px) rotate(0); }
    100% { transform: translateY(120vh) translateX(100px) rotate(360deg); }
}

/* الورود الحقيقية البينك */
.real-petal {
    position: fixed;
    top: -60px;
    pointer-events: none;
    z-index: 5;
    opacity: .9;
}

@keyframes petalFall {
    0% { transform: translateY(-80px) rotate(0); }
    100% { transform: translateY(120vh) translateX(100px) rotate(360deg); }
}

/* تظبيط مكان وتوسيط صورة البروفايل */
.profile-section {
    position: relative;
    width: 140px;
    height: 140px;
    margin: 0 auto 20px auto !important; /* توسيط أفقي إجباري */
    display: flex;
    justify-content: center;
    align-items: center;
}

.profile-img, .avatar, img.profile {
    width: 120px !important;
    height: 120px !important;
    border-radius: 50%;
    object-fit: cover;
    position: relative !important;
    transform: none !important;
    margin: auto !important;
    z-index: 2;
    border: 3px solid rgba(255, 255, 255, 0.2);
}

/* تأثير التلج (Frost) على حواف النص فقط */
.title-text {
    font-family: 'Great Vibes', cursive;
    color: #ffffff;
    text-shadow: 
        -1px -1px 3px rgba(174,228,255,0.8), 
         1px -1px 3px rgba(174,228,255,0.8), 
        -1px  1px 3px rgba(174,228,255,0.8), 
         1px  1px 3px rgba(174,228,255,0.8);
}

/* شاشة التحميل الأصلية */
.loaderx {
    position: fixed;
    inset: 0;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    color: white;
    font-size: 2rem;
    font-family: 'Great Vibes', cursive;
    transition: opacity 0.5s;
}

/* توسيط وتجاوب الكارت الزجاجي */
.scene {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    z-index: 2;
}

.card-3d {
    width: 100%;
    max-width: 420px;
    background: rgba(25, 25, 35, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 40px 20px;
    text-align: center;
    box-shadow: 0 15px 35px rgba(0,0,0,0.5);
}

/* تحسينات النصوص الكلاسيكية داخل الكارت */
h1 { margin-bottom: 15px; }
.title-flower { color: #f5a3b7; font-size: 1.5rem; vertical-align: super; }
.subtitle-classic { color: #ccc; font-size: 1.1rem; margin-bottom: 20px; }
.sub-dot { color: #d4af37; margin: 0 8px; }
.about-text { color: #e0e0e0; font-family: 'Cormorant Garamond', serif; font-size: 1.1rem; line-height: 1.6; margin-bottom: 20px; }
.stats-classic { display: flex; justify-content: space-around; background: rgba(0,0,0,0.3); padding: 15px; border-radius: 12px; margin-bottom: 20px; }
.stat-value { font-size: 1.4rem; font-weight: bold; color: #fff; }
.stat-label { font-size: 0.8rem; color: #aaa; }
.stat-connector { width: 1px; background: rgba(255,255,255,0.1); }
.quote-frame { font-style: italic; color: #b3b3cc; }
.quote-mark { color: #d4af37; font-size: 1.5rem; opacity: 0.5; }
</style>
</head>
<body>

<div class="loaderx" id="loaderx">✿ Miroo ✿</div>

<div class="scene">
  <div class="card-3d">
    <div class="card-glass">
      
      <div class="profile-section">
        <img src="miroo.webp" alt="Miroo" class="profile-img" onerror="this.src='https://via.placeholder.com/150'">
      </div>
      
      <h1 class="main-title">
        <span class="title-text">Miroo</span>
        <span class="title-flower">✿</span>
      </h1>
      
      <p class="subtitle-classic">
        <span class="sub-age">١٩ ربيعاً</span>
        <span class="sub-dot">•</span>
        <span class="sub-origin">أردنية الأصل</span>
        <span class="sub-dot">•</span>
        <span class="sub-life">نشأت في أرض الحرمين</span>
      </p>
      
      <div class="about-classic">
        <p class="about-text">
          روحٌ حالمةٌ تُحبُّ الجمالَ، والورودَ، واللحظاتِ الهادئة،<br>
          والإبداعَ، وجمعَ الذكريات. تُلهمُها الأناقةُ،<br>
          والألوانُ الناعمةُ، والأجواءُ الساحرة.
        </p>
      </div>
      
      <div class="stats-classic">
        <div class="stat-box">
          <div class="stat-value">١٩</div>
          <div class="stat-label">عاماً من العُمر</div>
        </div>
        <div class="stat-connector"></div>
        <div class="stat-box">
          <div class="stat-value">🇯🇴</div>
          <div class="stat-label">الأردن الحبيب</div>
        </div>
        <div class="stat-connector"></div>
        <div class="stat-box">
          <div class="stat-value">🇸🇦</div>
          <div class="stat-label">أرض النور</div>
        </div>
      </div>
      
      <div class="quote-classic">
        <div class="quote-frame">
          <span class="quote-mark open">“</span>
          <span class="quote-text">
            اِزْهَرِي بِهُدُوءٍ، وَلِمِي بِبُرُوقٍ،<br>
            وَلَا تَتَوَقَّفِي عَنِ الحُلْم.
          </span>
          <span class="quote-mark close">”</span>
        </div>
      </div>
      
    </div>
  </div>
</div>

<script src="script.js"></script>

<script>
window.addEventListener('load', () => {
    // إخفاء اللودر
    const loader = document.getElementById('loaderx');
    if (loader) {
        loader.style.opacity = '0';
        setTimeout(() => loader.remove(), 500);
    }

    // توليد بتلات الورد البينك
    const svg = `data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 60 60'><path fill='%23f5a3b7' d='M30 5 C42 10 55 20 48 35 C42 48 25 55 15 45 C5 35 10 15 30 5Z'/></svg>`;
    for(let i=0; i<25; i++) {
        let p = document.createElement('img');
        p.src = svg;
        p.className = 'real-petal';
        p.style.left = Math.random() * 100 + 'vw';
        p.style.width = (14 + Math.random() * 20) + 'px';
        p.style.animation = 'petalFall ' + (8 + Math.random() * 8) + 's linear infinite';
        p.style.animationDelay = (Math.random() * 5) + 's';
        document.body.appendChild(p);
    }
});
</script>

<script>
window.addEventListener('load', () => {
    // توليد الورود الزرقاء زي ما كانت في البروجيكت
    for(let i=0; i<20; i++) {
        const r = document.createElement('img');
        r.src = 'blue_rose.png'; // ملف الوردة الزرقاء الأصلي بتاعك
        r.className = 'blue-rose';
        r.style.left = Math.random() * 100 + 'vw';
        r.style.width = (22 + Math.random() * 30) + 'px';
        r.style.animationDuration = (10 + Math.random() * 10) + 's';
        r.style.animationDelay = (Math.random() * 5) + 's';
        document.body.appendChild(r);
    }
});
</script>

</body>
</html>
